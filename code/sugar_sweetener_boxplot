    "EU":        EU_MEMBERS,
    "China":     "China, mainland",
    "Korea":     "Republic of Korea",
}
# EU transition
REGION_GROUP = {r: "fast" for r in REGIONS}
 
YEARS = np.arange(2020, 2041)
PLOT_YEARS = np.arange(2020, 2041, 2)
SCEN_START = 2030
 

# loaders

def load_fao(path, item):
    df = pd.read_csv(path)
    df = df[(df["Item"] == item)
            & (df["Element"] == "Food supply quantity (kg/capita/yr)")].copy()
    df = df[df["Area"] != "China"]
    df["Value"] = pd.to_numeric(df["Value"], errors="coerce")
    return df
 
FAO_SUGAR = load_fao(P("sugar_fao"), "Sugar (Raw Equivalent)")
FAO_SWE   = load_fao(P("swe_fao"),   "Sweeteners, Other")
SWE_2030  = pd.read_csv(P("swe_2030"))
 
def observed_series(fao_df, area):
    """area (string or list of member states) -> {year: value} (FAOSTAT obs)."""
    if isinstance(area, list):
        sub = fao_df[fao_df["Area"].isin(area)]
        s = sub.groupby("Year")["Value"].mean()
    else:
        sub = fao_df[fao_df["Area"] == area]
        s = sub.set_index("Year")["Value"]
    return s.to_dict()
 
def base_2030(fao_df, area):
    """2030 baseline = FAOSTAT recent 5-year mean (same as sugar_map.py)."""
    obs = observed_series(fao_df, area)
    return float(np.mean(list(obs.values()))) if obs else np.nan
 
def swe_base_2030(region):
    """Sweetener 2030 baseline (g/capita/yr, fictional)."""
    if FICTION["swe_baseline_mode"] == "uniform":
        return FICTION["swe_uniform_base"]
    area = REGIONS[region]
    if isinstance(area, list):
        sub = SWE_2030[SWE_2030["Area"].isin(area)]
        v = float(sub["y2030"].mean())
    else:
        r = SWE_2030[SWE_2030["Area"] == area]
        v = float(r["y2030"].values[0]) if len(r) else np.nan
    return v * FICTION["swe_data_scale"]
 

# Yearly central trajectories

def _interp_anchors(anchors):

    xs = sorted(anchors)
    out = {}
    for y in YEARS:
        lo = max([a for a in xs if a <= y], default=xs[0])
        hi = min([a for a in xs if a >= y], default=xs[-1])
        if lo == hi:
            out[y] = anchors[lo]
        else:
            v0, v1 = max(anchors[lo], 1e-4), max(anchors[hi], 1e-4)
            out[y] = float(np.exp(np.interp(y, [lo, hi],
                                            [np.log(v0), np.log(v1)])))
    return out
 
def sugar_central(region):
    """Sugar kg/capita/yr: 2020-23 observed, 24-29 converge to baseline,
    30-40 scenario."""
    area = REGIONS[region]
    obs = observed_series(FAO_SUGAR, area)
    b30 = base_2030(FAO_SUGAR, area)
    g = REGION_GROUP[region]
    anchors = {2023: obs.get(2023, b30),
               2030: b30 * SUGAR_MULT[g][2030],
               2035: b30 * SUGAR_MULT[g][2035],
               2040: b30 * SUGAR_MULT[g][2040]}
    path = _interp_anchors(anchors)
    for y in obs:                      # overwrite observed years with real data
        if 2020 <= y <= 2023:
            path[y] = obs[y]
    return path
 
def nns_central(region, substance):
    """Sweetener g/capita/yr: baseline -> gentle rise to 2030 -> steep scenario
    rise (with a per-region ceiling)."""
    b = swe_base_2030(region) * FICTION["nns_level"][substance]
    g = REGION_GROUP[region]
    m = FICTION["nns_mult"][g]
    s0 = FICTION["pre2030_start"]
    ceil = FICTION["nns_region_ceiling"].get(region, 1.0)
    anchors = {2020: b * s0,
               2030: b * m[2030],
               2035: b * (1 + (m[2035] - 1) * ceil),   # uniform start, per-region ceiling
               2040: b * (1 + (m[2040] - 1) * ceil)}
    return _interp_anchors(anchors)
 

# sample generator 

def make_samples(center, year):
    frac = 0 if year < SCEN_START else (year - SCEN_START) / (2040 - SCEN_START)
    cv = FICTION["cv_observed"] + frac * (FICTION["cv_scenario_2040"] - FICTION["cv_observed"])
    n = FICTION["n_box"]
    s = RNG.normal(center, max(center, 1e-6) * cv, n)
    k = RNG.binomial(n, FICTION["outlier_rate"] if year >= SCEN_START else 0.01)
    if k:
        idx = RNG.choice(n, k, replace=False)
        s[idx] = center * RNG.uniform(1.4, 2.0, k) * RNG.choice([1, 1, 0.4], k)
    return np.clip(s, 0, None)
 
