for ci, region in enumerate(region_names):
    for ri, (label, kind, sub) in enumerate(ROWS):
        ax = axes[ri, ci]
        central = sugar_central(region) if kind == "sugar" else nns_central(region, sub)
        data = [make_samples(central[y], y) for y in PLOT_YEARS]
        ax.boxplot(data, positions=PLOT_YEARS, widths=1.3,
                   patch_artist=True, showfliers=True,
                   flierprops=dict(marker="o", markersize=3, markerfacecolor="none",
                                   markeredgecolor="0.4"),
                   medianprops=dict(color="black", lw=1),
                   boxprops=dict(facecolor="0.8", edgecolor="0.3", lw=0.7),
                   whiskerprops=dict(color="0.3"), capprops=dict(color="0.3"))
        ax.axvspan(SCEN_START, 2040, color="0.85", alpha=0.5, zorder=0)
        # (titles / y-labels intentionally omitted -- add in PowerPoint)
 
# unify y-scale per row + force x-axis (boxplot overrides it, so do this last)
for ri, (_, kind, sub) in enumerate(ROWS):
    ymax = 0
    for region in region_names:
        c = sugar_central(region) if kind == "sugar" else nns_central(region, sub)
        ymax = max(ymax, max(np.concatenate([make_samples(c[y], y) for y in PLOT_YEARS])))
    for ax in axes[ri]:
        ax.set_xlim(2018.5, 2041.5)
        ax.set_xticks([2020, 2030, 2040]); ax.set_xticklabels([2020, 2030, 2040])
