# plot
# Rows (top -> bottom): Sucralose, Aspartame, Sugar
# Cols (left -> right): Australia, Canada, USA, EU, China, Korea
# ---------------------------------------------------------------------------
plt.rcParams["axes.unicode_minus"] = False
 
ROWS = [("Sucralose (g/capita/yr)", "nns", "Sucralose"),
